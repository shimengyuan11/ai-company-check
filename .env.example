# 复制成 .env 再填。不要把填好的 .env 提交到仓库（.gitignore 已经挡住）。

# ── 必填 ──────────────────────────────────────────────
# Postgres 连接串。Neon 免费层记得带 ?sslmode=require
DATABASE_URL=postgresql://user:password@host.example.com/dbname?sslmode=require

# 会话 cookie 的签名密钥：随便一串长随机字符（越长越好）
SESSION_SECRET=change-me-to-a-long-random-string

# ── 建议 ──────────────────────────────────────────────
# 注册邀请码。不设的话任何人都能注册你的部署
SIGNUP_CODE=change-me

# ── 可选 ──────────────────────────────────────────────
# 每人每天最多生成次数（背调 + 话术共用一个计数）
LLM_DAILY_LIMIT=100

# 加密存 provider 的 api_key 用的 Fernet key。
# 不设的话程序会在本地生成 .secrets.key 文件，并自动创建
# SECRETS_KEY=...

# 注意：模型 key **不在这里**。
# 登录后在「智能体」页添加渠道，填你自己的 Base URL / 模型 / API Key。
# 这样部署者不会替所有访客付钱。
